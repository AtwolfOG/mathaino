# Local development credentials only. Never use these credentials in production.
DATABASE_URL=postgresql://mathaino:mathaino_local@127.0.0.1:54329/mathaino
AUTH_DATABASE_URL=postgresql://mathaino_auth:mathaino_auth_local@127.0.0.1:54329/mathaino
BETTER_AUTH_URL=http://localhost:3000
# Set your own generated secret in .env.local: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-secret-at-least-32-characters

# Optional development-only whisper.cpp server (Whisper Small.en recommended).
LOCAL_WHISPER_ENABLED=false
LOCAL_WHISPER_URL=http://127.0.0.1:8080

# Explicitly supply this to integration tests; they never fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql://mathaino_test:mathaino_test_local@127.0.0.1:54330/mathaino_test
TEST_AUTH_DATABASE_URL=postgresql://mathaino_auth:mathaino_auth_test_local@127.0.0.1:54330/mathaino_test
